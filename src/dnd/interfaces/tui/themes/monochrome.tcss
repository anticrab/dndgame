/* Monochrome theme — соответствует UI.md §3.2.
 *
 * Семантика — через жирность/инверсию/подчёркивание, без цвета.
 * Layout как в color.tcss; меняем только палитру.
 */

Screen {
    background: black;
    color: white;
}

Header {
    background: white;
    color: black;
    text-style: bold;
}

Footer {
    background: white;
    color: black;
}

StatusWidget {
    background: black;
    color: white;
    padding: 0 1;
    border: solid white;
    text-style: bold;
    height: 3;
}

#battle-row {
    height: 1fr;
}

MapWidget {
    background: black;
    color: white;
    padding: 0 1;
    border: solid white;
    width: 1fr;
    height: 1fr;
}

InitiativeWidget {
    background: black;
    color: white;
    padding: 0 1;
    border: solid white;
    width: 30;
    height: 1fr;
}

LogWidget {
    background: black;
    color: white;
    border: solid white;
    height: 12;
}

.modal-box {
    background: black;
    border: double white;
    padding: 1 2;
    width: 60;
    height: auto;
}

.modal-title {
    color: white;
    text-style: bold reverse;
}

.-hidden { display: none; }
