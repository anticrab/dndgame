/* Color theme (default) — соответствует UI.md §3.1.
 *
 * Семантика передаётся цветом: PC жёлтый, враг красный, союзник cyan.
 * Rich-разметка цветов уровня клеток применяется внутри widgets
 * (см. map_widget.render_battlefield); CSS отвечает за layout, фон,
 * бордюры.
 */

Screen {
    background: $background;
    color: $text;
}

Header {
    background: $surface;
    color: $text;
    text-style: bold;
}

Footer {
    background: $surface;
    color: $text;
}

/* Статус — узкая полоса сверху. */
StatusWidget {
    background: $surface;
    color: $text;
    padding: 0 1;
    border: round $accent;
    height: 3;
}

/* Главный ряд: карта слева растягивается, инициатива справа фикс. */
#battle-row {
    height: 1fr;
}

MapWidget {
    background: $background;
    color: $text;
    padding: 0 1;
    border: round $accent;
    width: 1fr;
    height: 1fr;
}

InitiativeWidget {
    background: $surface;
    color: $text;
    padding: 0 1;
    border: round $accent;
    width: 30;
    height: 1fr;
}

/* Лог — фиксированная высота внизу. */
LogWidget {
    background: $background;
    color: $text;
    border: round $accent;
    height: 12;
}

/* Модальные picker'ы (TargetPicker / MovePicker). */
.modal-box {
    background: $surface;
    border: round $secondary;
    padding: 1 2;
    width: 60;
    height: auto;
}

.modal-title {
    color: $secondary;
    text-style: bold;
}
